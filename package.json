{
  "name": "words-by-cork",
  "version": "1.0.0",
  "private": true,
  "description": "Words by Cork — a calm word game",
  "scripts": {
    "build": "node build.js",
    "sync": "npm run build && npx cap sync",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#101010' --iconBackgroundColorDark '#101010' --splashBackgroundColor '#fbf3e8' --splashBackgroundColorDark '#fbf3e8'",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor-community/text-to-speech": "^5.0.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@babel/standalone": "^7.25.6",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
